DOCKER_APP_ENV=prod
DOCKER_APP_DEBUG=0
DOCKER_APP_SECRET=replace-with-64-char-random-secret

# Public URL of the app behind the Nginx Proxy Manager (used for share links)
DOCKER_DEFAULT_URI=https://wichtler.example.com

DOCKER_DB_ROOT_PASSWORD=replace-with-strong-root-password
DOCKER_DB_NAME=wichtler
DOCKER_DB_USER=wichtler
DOCKER_DB_PASSWORD=replace-with-strong-app-password

# Proxies whose X-Forwarded-* headers are trusted. REMOTE_ADDR trusts whoever connects,
# which is safe as long as only the proxy manager can reach the container.
DOCKER_TRUSTED_PROXIES=REMOTE_ADDR

# Optional: fixed host port for a test without the proxy manager (default: random loopback port).
# DOCKER_HTTP_BIND=127.0.0.1:8089:80
